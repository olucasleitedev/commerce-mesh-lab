# PostgreSQL (Supabase connection string or local Postgres)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/commerce_mesh

# AWS / LocalStack
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_ENDPOINT_URL=http://localhost:4566
SQS_ORDERS_QUEUE_URL=http://sqs.us-east-1.localhost.localstack.cloud:4566/000000000000/commerce-mesh-orders
SQS_ORDERS_DLQ_URL=http://sqs.us-east-1.localhost.localstack.cloud:4566/000000000000/commerce-mesh-orders-dlq

# orders-api
PORT=3001
HOST=0.0.0.0
CORS_ORIGIN=http://localhost:5173

# Datadog (leave empty / disabled for local without agent)
DD_TRACE_ENABLED=false
DD_SERVICE=commerce-mesh
DD_ENV=local
DD_AGENT_HOST=localhost
DD_TRACE_AGENT_PORT=8126
